# Hippocampus configuration
# Copy to .env and adjust as needed

# Database
HIPPOCAMPUS_DB_URL=postgresql://localhost:5432/hippocampus

# Vector search tuning (pgvector HNSW). Iterative scan keeps results
# accurate when owner_id/type filters are applied after the ANN cut.
# iterative_scan requires pgvector >= 0.8 (ignored on older versions).
HIPPOCAMPUS_HNSW_ITERATIVE_SCAN=relaxed_order
HIPPOCAMPUS_HNSW_EF_SEARCH=100

# Ollama
HIPPOCAMPUS_OLLAMA_URL=http://localhost:11434
HIPPOCAMPUS_EMBEDDING_MODEL=nomic-embed-text-v2-moe
HIPPOCAMPUS_EMBEDDING_DIMENSIONS=768
HIPPOCAMPUS_EMBEDDING_PREFIX=true

# REST API
HIPPOCAMPUS_API_HOST=0.0.0.0
HIPPOCAMPUS_API_PORT=8420

# MCP SSE transport
HIPPOCAMPUS_MCP_SSE_HOST=0.0.0.0
HIPPOCAMPUS_MCP_SSE_PORT=8421

# Multi-tenancy
HIPPOCAMPUS_DEFAULT_OWNER=default
